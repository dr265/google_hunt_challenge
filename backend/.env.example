# ============ NEXUS AI Campus — backend config ============
# LLM: OpenAI-compatible gateway (Gemini flash models).
# Get a key at https://cleanapis.com - do not use Google/Gemini APIs directly.
CLEANAPIS_BASE_URL=https://cleanapis.com/v1
CLEANAPIS_API_KEY=your-cleanapis-key-here
CLEANAPIS_MODEL=gemini-3.7-flash
# Fallback models tried in order if primary errors
CLEANAPIS_FALLBACK_MODELS=gemini-3.6-flash,gemma-2-2b

# Campus data source (AI web scraper target)
SRMAP_URL=https://www.srmap.edu.in/

# Auth (dev tokens are signed with this; change in production)
NEXUS_JWT_SECRET=change-me-to-32-plus-random-chars

# Port the backend binds (8000 is used by another local service on this machine)
NEXUS_PORT=8010
