# ============ NEXUS AI Campus - frontend config ============
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` - it is git-ignored.

# Clerk publishable key (Google sign-in).
# Dashboard: https://dashboard.clerk.com -> API Keys -> Frontend API
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Where the frontend sends /api/* requests.
# In dev, Vite proxies these to NEXUS_API_URL (default http://localhost:8010).
VITE_API_BASE=/api

# Port of the FastAPI backend (used by the Vite dev-server proxy only).
# Not required by the browser bundle.
NEXUS_API_URL=http://localhost:8010
